{
  "name": "@maildun/email-builder",
  "version": "0.4.0",
  "description": "Agentic-first email builder: a typed document model, an operations API for LLM agents, a dependency-light HTML renderer, and a modern React editor.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maildun/email-builder.git"
  },
  "homepage": "https://github.com/Maildun/email-builder#readme",
  "bugs": {
    "url": "https://github.com/Maildun/email-builder/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "newsletter",
    "react",
    "agent",
    "llm",
    "mcp",
    "html-email"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "email-builder": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core.css": "./dist/core.css",
    "./editor.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && bun scripts/build-css.ts",
    "dev": "cd playground && bun install --silent && bun run dev",
    "docs:dev": "cd docs && bun install --silent && bun run dev --port 5174",
    "docs:build": "cd docs && bun install --silent && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "ui:fix": "bun scripts/fix-shadcn-imports.ts",
    "icons": "bun scripts/build-social-icons.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bootstrap-icons": "^1.13.1",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.1",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
